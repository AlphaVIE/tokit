fn array_sum(n:i32,xs:[i32])->i32{var i=0;var index=0;var total=0;while i<n{total=total+xs[index];if index==len(xs)-1{index=0;}else{index=index+1;};i=i+1;}total}
fn main()->Result<i32,ParseError>{let values=args();if len(values)==4{let n=parse_i32(values[0])?;let xs=[parse_i32(values[1])?,parse_i32(values[2])?,parse_i32(values[3])?];Ok(array_sum(n,xs))}else{Err(ParseError::Invalid)}}
