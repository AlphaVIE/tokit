fn sum(n:i32,x:[i64])->i64{var i=0;var p=0;var total=0i64;while i<n{total=total+x[p];if p==len(x)-1{p=0;}else{p=p+1;};i=i+1;}total}
fn main()->Result<i64,ParseError>{let a=args();if len(a)>=3{let n=parse_i32(a[0])?;var x:[i64]=[];var i=1;while i<len(a){x.push(parse_i64(a[i])?);i=i+1;}Ok(sum(n,x))}else{Err(ParseError::Invalid)}}
