{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tokit",
  "scopeName": "source.tokit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#variants" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.tokit", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tokit",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.tokit", "match": "\\\\[ntr\"\\\\]" },
            { "name": "invalid.illegal.escape.tokit", "match": "\\\\." }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.tokit" },
            "2": { "name": "entity.name.type.tokit" }
          }
        },
        {
          "match": "^(?:\\s*pub\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^>]*>)?\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.tokit" }
          }
        },
        {
          "match": "(?<=\\})(?:pub\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^>]*>)?\\s*\\([^)]*\\)\\s*->)",
          "captures": {
            "1": { "name": "entity.name.function.tokit" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.tokit", "match": "\\b(if|else|match|for|in|while|break|continue|return|spawn)\\b" },
        { "name": "keyword.declaration.tokit", "match": "\\b(struct|enum|import|pub|let|var|fn)\\b" },
        { "name": "constant.language.tokit", "match": "\\b(true|false|None)\\b" },
        { "name": "support.function.constructor.tokit", "match": "\\b(Ok|Err|Some)\\b" }
      ]
    },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.tokit", "match": "\\b(i32|i64|f64|I|L|F|bool|String|Bytes|Unit)\\b" },
        { "name": "support.type.tokit", "match": "\\b(Result|Option|Task|Map|Conn|Request|Response|IoError|ParseError|TaskError)\\b" },
        { "name": "entity.name.type.tokit", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.tokit", "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.tokit", "match": "\\b[0-9]+(?:i64)?\\b" }
      ]
    },
    "variants": {
      "patterns": [
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.tokit" },
            "2": { "name": "punctuation.separator.namespace.tokit" },
            "3": { "name": "entity.name.tag.variant.tokit" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tokit" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.tokit", "match": "->|=>" },
        { "name": "keyword.operator.comparison.tokit", "match": "==|!=|<=|>=" },
        { "name": "keyword.operator.logical.tokit", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.try.tokit", "match": "\\?" },
        { "name": "keyword.operator.arithmetic.tokit", "match": "[-+*/%]" },
        { "name": "keyword.operator.assignment.tokit", "match": "=" },
        { "name": "punctuation.definition.lambda.tokit", "match": "\\|" }
      ]
    }
  }
}
