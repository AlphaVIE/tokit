// In-memory CRUD service: `tok run --allow-net 127.0.0.1:8080 examples/crud_service.tok -- 127.0.0.1:8080 0`
// PUT /items/<key> stores the body, GET /items/<key> reads it, DELETE removes it, GET /items lists keys.
reply(status:I,body:String)->Response{var h:Map<String,String>=Map();h["content-type"]="text/plain";Response(status,h,body)}
route(store:Map<String,String>,r:Request)->Response{let parts=split(r.path,"/");if r.path=="/items"&&r.method=="GET"{return reply(200,join(keys(store),"\n"));}if len(parts)!=3||parts[1]!="items"{return reply(404,"not found");}match get(store,parts[2]){Some(v)=>match r.method{"PUT"=>reply(200,"replaced"),"GET"=>reply(200,v),"DELETE"=>reply(204,""),_=>reply(405,"method not allowed")},None=>match r.method{"PUT"=>reply(201,"created"),_=>reply(404,"not found")}}}
main()->Unit{let a=args();let limit=match parse_i32(a[1]){Ok(n)=>n,Err(e)=>0};let l=match listen(a[0]){Ok(l)=>l,Err(e)=>{print("cannot listen on "+a[0]);exit(1)}};print("listening on "+a[0]);var store:Map<String,String>=Map();var served=0;while limit<=0||served<limit{let c=match accept(l){Ok(c)=>c,Err(e)=>{continue;}};served=served+1;match http_read(c){Ok(r)=>{let res=route(store,r);let k=split(r.path,"/");if res.status<300&&len(k)==3{if r.method=="PUT"{store[k[2]]=r.body;}if r.method=="DELETE"{store=remove(store,k[2]);}}http_write(c,res);},Err(e)=>{http_write(c,reply(400,"bad request"));}}tcp_close(c);}}
