import json="json.tok";fn normalized(source:String,expected:String)->bool{match json::parse(source){Ok(value)=>match json::render(value){Ok(text)=>text==expected,Err(error)=>false},Err(error)=>false}}
fn fails_at(source:String,offset:i32)->bool{match json::parse(source){Ok(value)=>false,Err(error)=>error.offset==offset}}
fn test_json_parse_scalars()->bool{if normalized(" null ","null"){}else{return false;};if normalized("true","true"){}else{return false;};if normalized("false","false"){}else{return false;};if normalized("-0","-0"){}else{return false;};if normalized("1.25e-3","1.25e-3"){}else{return false;};if normalized("\"Grüße\"","\"Grüße\""){}else{return false;};true}
fn test_json_parse_collections()->bool{if normalized(" [ ] ","[]"){}else{return false;};if normalized(" { } ","{}"){}else{return false;};if normalized(" [null, true, -12.5e+2] ","[null,true,-12.5e+2]"){}else{return false;};if normalized("{\"a\":1,\"a\":[false,null]}","{\"a\":1,\"a\":[false,null]}"){}else{return false;};true}
fn test_json_parse_escapes()->bool{if normalized("\"\\u0041\"","\"A\""){}else{return false;};if normalized("\"\\uD83D\\uDE00\"","\"😀\""){}else{return false;};if normalized("\"a\\/b\"","\"a/b\""){}else{return false;};if normalized("\"line\\nend\"","\"line\\nend\""){}else{return false;};if normalized("\"\\b\\f\\r\\t\"","\"\\b\\f\\r\\t\""){}else{return false;};true}
fn test_json_parse_rejects_invalid()->bool{if fails_at("",0){}else{return false;};if fails_at("nul",3){}else{return false;};if fails_at("01",0){}else{return false;};if fails_at("truex",4){}else{return false;};if fails_at("[1,]",3){}else{return false;};if fails_at("{\"a\":}",5){}else{return false;};if fails_at("[1 2]",3){}else{return false;};if fails_at("\"\\q\"",2){}else{return false;};if fails_at("\"\\uD800\"",7){}else{return false;};if fails_at("\"\\uDE00\"",3){}else{return false;};true}
fn test_json_parse_rejects_raw_control()->bool{let source:String=match utf8_decode([34,10,34]){Some(text)=>text,None=>""};fails_at(source,1)}
fn nested_arrays(count:i32)->String{var source:String="0";var at:i32=0;while at<count{source="["+source+"]";at=at+1;}source}
fn test_json_parse_depth_limit()->bool{match json::parse(nested_arrays(12)){Ok(value)=>{},Err(error)=>{return false;}};match json::parse(nested_arrays(13)){Ok(value)=>false,Err(error)=>error.offset==13}}
