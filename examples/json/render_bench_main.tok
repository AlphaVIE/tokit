import json="json.tok";fn main()->Option<i32>{let inputs=args();if len(inputs)==3{match parse_i32(inputs[1]){Ok(count)=>{if count<1{return None;}else{};let value:json::Value=match json::parse(inputs[0]){Ok(value)=>value,Err(error)=>{return None;}};var total=0;var at=0;while at<count{let output:String=match json::render(value){Ok(text)=>text,Err(error)=>{return None;}};if output==inputs[2]{}else{return None;};total=total+len(utf8_encode(output));at=at+1;}Some(total)},Err(error)=>None}}else{None}}
