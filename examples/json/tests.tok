import json="json.tok";fn accepted(text:String)->bool{match json::render(json::Value::Number(text)){Ok(value)=>true,Err(error)=>false}}
fn escaped(value:String,expected:[i32])->bool{match json::render(json::Value::Text(value)){Ok(text)=>match utf8_decode(expected){Some(want)=>text==want,None=>false},Err(error)=>false}}
fn test_json_number_forms()->bool{if accepted("0"){}else{return false;};if accepted("-0"){}else{return false;};if accepted("123"){}else{return false;};if accepted("-12.5e+2"){}else{return false;};if accepted("1E-9"){}else{return false;};if accepted("1.0"){}else{return false;};true}
fn test_json_rejects_bad_numbers()->bool{if accepted(""){return false;}else{};if accepted("01"){return false;}else{};if accepted("+1"){return false;}else{};if accepted("-"){return false;}else{};if accepted("1."){return false;}else{};if accepted("1e"){return false;}else{};if accepted("1e+"){return false;}else{};if accepted("1e2x"){return false;}else{};if accepted(" 1"){return false;}else{};if accepted("١"){return false;}else{};true}
fn test_json_string_escapes()->bool{let zero:String=match utf8_decode([0]){Some(text)=>text,None=>""};if escaped(zero,[34,92,117,48,48,48,48,34]){}else{return false;};if escaped("\n",[34,92,110,34]){}else{return false;};if escaped("\r",[34,92,114,34]){}else{return false;};if escaped("\t",[34,92,116,34]){}else{return false;};if escaped("\"",[34,92,34,34]){}else{return false;};if escaped("\\",[34,92,92,34]){}else{return false;};if escaped("é",[34,195,169,34]){}else{return false;};true}
fn test_json_nested_values()->bool{let item:json::Value=json::Value::Array([json::Value::Null,json::Value::Bool(true),json::Value::Number("3")]);match json::render(item){Ok(text)=>text=="[null,true,3]",Err(error)=>false}}
fn test_json_remaining_controls()->bool{let backspace:String=match utf8_decode([8]){Some(text)=>text,None=>""};let formfeed:String=match utf8_decode([12]){Some(text)=>text,None=>""};let last_control:String=match utf8_decode([31]){Some(text)=>text,None=>""};if escaped(backspace,[34,92,98,34]){}else{return false;};if escaped(formfeed,[34,92,102,34]){}else{return false;};if escaped(last_control,[34,92,117,48,48,49,102,34]){}else{return false;};true}
fn test_json_object_order()->bool{let members:[json::Member]=[json::Member("a",json::Value::Number("1")),json::Member("a",json::Value::Bool(true))];match json::render(json::Value::Object(members)){Ok(text)=>text=="{\"a\":1,\"a\":true}",Err(error)=>false}}
