// WebSocket echo service: `tok run --allow-net 127.0.0.1:8080 examples/websocket_echo/main.tok -- 127.0.0.1:8080 0`
// Each connection is upgraded, every text or binary message is sent back, and Close ends the connection.
import ws="pkg:websocket";echo(s:ws::Socket)->Result<I,String>{var count=0;while true{let m=ws::receive(s)?;match m.kind{ws::Kind::Close=>{ws::close(s);return Ok(count);},ws::Kind::Text=>ws::send_text(s,"echo: "+ws::text(m))?,ws::Kind::Binary=>ws::send_binary(s,m.data)?}count=count+1;}Ok(count)}
main()->Unit{let a=args();let limit=match parse_i32(a[1]){Ok(n)=>n,Err(e)=>0};let l=match listen(a[0]){Ok(l)=>l,Err(e)=>{print("cannot listen on "+a[0]);exit(1)}};print("listening on "+a[0]);var served=0;while limit<=0||served<limit{let c=match accept(l){Ok(c)=>c,Err(e)=>{continue;}};served=served+1;match http_read(c){Ok(r)=>match ws::upgrade(c,r){Ok(s)=>match echo(s){Ok(n)=>print("connection closed after "+String(n)+" messages"),Err(e)=>{print("connection failed: "+e);tcp_close(c);}},Err(e)=>print("rejected: "+e)},Err(e)=>tcp_close(c)}}}
