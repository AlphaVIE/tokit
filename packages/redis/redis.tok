// Redis client speaking RESP2 over a TCP connection (needs --allow-net host:port).
pub enum Reply{Nil,Text(String),Error(String),Int(L),Bulk(String),Many([Reply])}pub struct Client{conn:Conn}
struct Parsed{reply:Reply,next:I}
struct Line{text:String,next:I}pub connect(addr:String)->Result<Client,String>{match tcp_connect(addr){Ok(c)=>Ok(Client(c)),Err(e)=>Err("cannot connect to "+addr)}}pub close(c:Client)->Unit{tcp_close(c.conn)}
encode(args:[String])->String{var out="*"+String(len(args))+"\r\n";for a in args{out=out+"$"+String(len(utf8_encode(a)))+"\r\n"+a+"\r\n";}out}
text(b:Bytes,from:I,to:I)->String{var part=utf8_encode("");for i in range(from,to){part.push(b[i]);}match utf8_decode_bytes(part){Some(t)=>t,None=>""}}
line(b:Bytes,at:I)->Option<Line>{var i=at;while i+1<len(b){if b[i]==13&&b[i+1]==10{return Some(Line(text(b,at,i),i+2));}i=i+1;}None}
number(t:String)->L{match parse_i64(t){Ok(n)=>n,Err(e)=>-1i64}}
// The reply starting at `at`, or None while more bytes are needed.
parse(b:Bytes,at:I)->Option<Parsed>{if at>=len(b){return None;}let head=line(b,at+1)?;match b[at]{43=>Some(Parsed(Reply::Text(head.text),head.next)),45=>Some(Parsed(Reply::Error(head.text),head.next)),58=>Some(Parsed(Reply::Int(number(head.text)),head.next)),36=>{let n=number(head.text);if n<0i64{return Some(Parsed(Reply::Nil,head.next));}let size=i32(n)?;if head.next+size+2>len(b){return None;}Some(Parsed(Reply::Bulk(text(b,head.next,head.next+size)),head.next+size+2))},42=>{let n=number(head.text);if n<0i64{return Some(Parsed(Reply::Nil,head.next));}var items:[Reply]=[];var next=head.next;for i in range(0,i32(n)?){let item=parse(b,next)?;items.push(item.reply);next=item.next;}Some(Parsed(Reply::Many(items),next))},_=>Some(Parsed(Reply::Error("invalid reply"),len(b)))}}
// Send one command and read its complete reply.
pub cmd(c:Client,args:[String])->Result<Reply,String>{match tcp_send(c.conn,utf8_encode(encode(args))){Ok(u)=>{},Err(e)=>{return Err("send failed");}}var buf=utf8_encode("");while true{match parse(buf,0){Some(p)=>{return Ok(p.reply);},None=>{}}match tcp_recv(c.conn,65536){Ok(part)=>{if len(part)==0{return Err("connection closed");}for x in part{buf.push(x);}},Err(e)=>{return Err("receive failed");}}}Err("unreachable")}
fail(r:Reply)->String{match r{Reply::Error(m)=>m,_=>"unexpected reply"}}pub ping(c:Client)->Result<String,String>{let r=cmd(c,["PING"])?;match r{Reply::Text(t)=>Ok(t),_=>Err(fail(r))}}pub auth(c:Client,password:String)->Result<Unit,String>{let r=cmd(c,["AUTH",password])?;match r{Reply::Text(t)=>Ok(()),_=>Err(fail(r))}}pub fetch(c:Client,key:String)->Result<Option<String>,String>{let r=cmd(c,["GET",key])?;match r{Reply::Bulk(v)=>Ok(Some(v)),Reply::Nil=>Ok(None),_=>Err(fail(r))}}pub store(c:Client,key:String,value:String)->Result<Unit,String>{let r=cmd(c,["SET",key,value])?;match r{Reply::Text(t)=>Ok(()),_=>Err(fail(r))}}pub delete(c:Client,key:String)->Result<L,String>{let r=cmd(c,["DEL",key])?;match r{Reply::Int(n)=>Ok(n),_=>Err(fail(r))}}pub incr(c:Client,key:String)->Result<L,String>{let r=cmd(c,["INCR",key])?;match r{Reply::Int(n)=>Ok(n),_=>Err(fail(r))}}
