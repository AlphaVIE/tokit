// WebSocket (RFC 6455) server and client on Tokit connections (needs --allow-net host:port).
// Server: read the request with http_read, then upgrade(c,r). Client: connect(addr,path).
pub enum Kind{Text,Binary,Close}pub struct Message{kind:Kind,data:Bytes}pub struct Socket{conn:Conn,client:bool}
struct Frame{fin:bool,op:I,data:Bytes}
accept_key(key:String)->String{base64_encode(sha1(utf8_encode(key+"258EAFA5-E914-47DA-95CA-C5AB0DC85B11")))}
// Exactly n bytes, without reading past them.
read_exact(c:Conn,n:I)->Result<Bytes,String>{var got=utf8_encode("");while len(got)<n{match tcp_recv(c,n-len(got)){Ok(part)=>{if len(part)==0{return Err("connection closed");}for b in part{got.push(b);}},Err(e)=>{return Err("receive failed");}}}Ok(got)}
reject(c:Conn,why:String)->Result<Socket,String>{let h:Map<String,String>=Map();http_write(c,Response(400,h,why));tcp_close(c);Err(why)}
// Complete the server side of the opening handshake for a request read with http_read.
pub upgrade(c:Conn,r:Request)->Result<Socket,String>{if lower(get_or(r.headers,"upgrade",""))!="websocket"{return reject(c,"expected a WebSocket upgrade");}match get(r.headers,"sec-websocket-key"){Some(key)=>match tcp_send(c,utf8_encode("HTTP/1.1 101 Switching Protocols\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-accept: "+accept_key(key)+"\r\n\r\n")){Ok(u)=>Ok(Socket(c,false)),Err(e)=>Err("handshake failed")},None=>reject(c,"missing sec-websocket-key")}}
header(head:String,name:String)->Option<String>{for l in lines(head){let parts=split(l,":");if len(parts)>=2&&lower(trim(parts[0]))==name{return Some(trim(join(slice(parts,1,len(parts)),":")));}}None}
// Open a client connection to ws://addr/path.
pub connect(addr:String,path:String)->Result<Socket,String>{let c=match tcp_connect(addr){Ok(c)=>c,Err(e)=>{return Err("cannot connect to "+addr);}};let key=base64_encode(random_bytes(16));match tcp_send(c,utf8_encode("GET "+path+" HTTP/1.1\r\nhost: "+addr+"\r\nupgrade: websocket\r\nconnection: Upgrade\r\nsec-websocket-key: "+key+"\r\nsec-websocket-version: 13\r\n\r\n")){Ok(u)=>{},Err(e)=>{return Err("handshake failed");}}var head=utf8_encode("");while!ends_with(match utf8_decode_bytes(head){Some(t)=>t,None=>""},"\r\n\r\n"){if len(head)>8192{return Err("handshake response too large");}for b in read_exact(c,1)?{head.push(b);}}let text=match utf8_decode_bytes(head){Some(t)=>t,None=>""};if!starts_with(text,"HTTP/1.1 101"){tcp_close(c);return Err("server refused the upgrade");}let accepted=match header(text,"sec-websocket-accept"){Some(v)=>v==accept_key(key),None=>false};if!accepted{tcp_close(c);return Err("bad sec-websocket-accept");}Ok(Socket(c,true))}
read_frame(s:Socket)->Result<Frame,String>{let h=read_exact(s.conn,2)?;let masked=bit_and(h[1],128)!=0;if masked==s.client{return Err("wrong frame masking");}var n=bit_and(h[1],127);if n==126{let e=read_exact(s.conn,2)?;n=e[0]*256+e[1];}else if n==127{let e=read_exact(s.conn,8)?;if e[0]+e[1]+e[2]+e[3]!=0||e[4]>=128{return Err("frame too large");}n=((e[4]*256+e[5])*256+e[6])*256+e[7];}if n>16777216{return Err("frame too large");}let mask=if masked{read_exact(s.conn,4)?}else{utf8_encode("")};let raw=read_exact(s.conn,n)?;if!masked{return Ok(Frame(bit_and(h[0],128)!=0,bit_and(h[0],15),raw));}var data=utf8_encode("");var i=0;while i<n{data.push(bit_xor(raw[i],mask[i%4]));i=i+1;}Ok(Frame(bit_and(h[0],128)!=0,bit_and(h[0],15),data))}
send_frame(s:Socket,op:I,data:Bytes)->Result<Unit,String>{var out=utf8_encode("");out.push(128+op);let n=len(data);let m=if s.client{128}else{0};if n<126{out.push(m+n);}else if n<65536{out.push(m+126);out.push(shr(n,8));out.push(bit_and(n,255));}else{out.push(m+127);for k in[0,0,0,0,shr(n,24),bit_and(shr(n,16),255),bit_and(shr(n,8),255),bit_and(n,255)]{out.push(k);}}if s.client{let mask=random_bytes(4);for b in mask{out.push(b);}var i=0;while i<n{out.push(bit_xor(data[i],mask[i%4]));i=i+1;}}else{for b in data{out.push(b);}}match tcp_send(s.conn,out){Ok(u)=>Ok(()),Err(e)=>Err("send failed")}}
// The next text, binary, or close message. Pings are answered and pongs skipped;
// fragmented messages are joined. After a Close message, call close(s).
pub receive(s:Socket)->Result<Message,String>{var data=utf8_encode("");var first=-1;while true{let f=read_frame(s)?;match f.op{9=>{send_frame(s,10,f.data)?;},10=>{},8=>{return Ok(Message(Kind::Close,f.data));},0=>{if first<0{return Err("unexpected continuation frame");}},1=>{if first>=0{return Err("interleaved message");}first=1;},2=>{if first>=0{return Err("interleaved message");}first=2;},_=>{return Err("unknown opcode "+String(f.op));}}if f.op<=2{for b in f.data{data.push(b);}if len(data)>16777216{return Err("message too large");}if f.fin{return Ok(Message(if first==1{Kind::Text}else{Kind::Binary},data));}}}Err("connection closed")}pub send_text(s:Socket,text:String)->Result<Unit,String>{send_frame(s,1,utf8_encode(text))}pub send_binary(s:Socket,data:Bytes)->Result<Unit,String>{send_frame(s,2,data)}
// Send a normal-closure Close frame and close the connection.
pub close(s:Socket)->Unit{var code=utf8_encode("");code.push(3);code.push(232);send_frame(s,8,code);tcp_close(s.conn)}pub text(m:Message)->String{match utf8_decode_bytes(m.data){Some(t)=>t,None=>""}}
