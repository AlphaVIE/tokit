// Tokit's lexer written in Tokit. Reads source from standard input and prints
// one `Kind start end` line per token (byte offsets), exactly like `tok tokens`.
struct Tok{kind:String,end:I}
keyword(word:String)->String{match word{"fn"=>"Fn","struct"=>"Struct","enum"=>"Enum","import"=>"Import","pub"=>"Pub","let"=>"Let","var"=>"Var","for"=>"For","while"=>"While","break"=>"Break","continue"=>"Continue","in"=>"In","if"=>"If","match"=>"Match","spawn"=>"Spawn","else"=>"Else","return"=>"Return","true"=>"True","false"=>"False","Ok"=>"Ok","Err"=>"Err","Some"=>"Some","None"=>"None",_=>"Ident"}}
is_digit(b:I)->bool{b>=48&&b<=57}
is_word(b:I)->bool{b>=65&&b<=90||b>=97&&b<=122||b==95}
is_space(b:I)->bool{b==32||b==9||b==10||b==12||b==13}
at(s:Bytes,i:I)->I{if i<len(s){s[i]}else{-1}}
fail(code:String,start:I,end:I)->String{code+" "+String(start)+" "+String(end)}
text(s:Bytes,start:I,end:I)->String{var part=utf8_encode("");for i in range(start,end){part.push(s[i]);}match utf8_decode_bytes(part){Some(t)=>t,None=>""}}
word(s:Bytes,start:I)->Tok{var i=start+1;while is_word(at(s,i))||is_digit(at(s,i)){i=i+1;}Tok(keyword(text(s,start,i)),i)}
string(s:Bytes,start:I)->Result<Tok,String>{var i=start+1;while true{let b=at(s,i);if b==-1||b==10||b==13{return Err(fail("E004",start,i));}if b==34{return Ok(Tok("String",i+1));}if b==92{if !contains([110,116,114,34,92],at(s,i+1)){return Err(fail("E004",start,min(i+2,len(s))));}i=i+2;}else{i=i+1;}}Err(fail("E004",start,i))}
number(s:Bytes,start:I)->Result<Tok,String>{var i=start+1;while is_digit(at(s,i)){i=i+1;}let digits=i;if at(s,i)==46&&is_digit(at(s,i+1)){i=i+2;while is_digit(at(s,i)){i=i+1;}}let fraction=i!=digits;if at(s,i)==101||at(s,i)==69{i=i+1;if at(s,i)==43||at(s,i)==45{i=i+1;}if !is_digit(at(s,i)){return Err(fail("E003",start,i));}while is_digit(at(s,i)){i=i+1;}}if fraction||i!=digits{return Ok(Tok("Float64",i));}if at(s,i)==105&&at(s,i+1)==54&&at(s,i+2)==52&&!is_word(at(s,i+3))&&!is_digit(at(s,i+3)){return Ok(Tok("Int64",i+3));}Ok(Tok("Int",i))}
symbol(s:Bytes,i:I)->Result<Tok,String>{let next=at(s,i+1);let pair=match s[i]{58=>if next==58{"ColonColon"}else{""},45=>if next==62{"Arrow"}else{""},61=>if next==62{"FatArrow"}else if next==61{"EqEq"}else{""},33=>if next==61{"BangEq"}else{""},38=>if next==38{"AndAnd"}else{""},124=>if next==124{"OrOr"}else{""},60=>if next==61{"Le"}else{""},62=>if next==61{"Ge"}else{""},_=>""};if pair!=""{return Ok(Tok(pair,i+2));}let single=match s[i]{40=>"LParen",41=>"RParen",123=>"LBrace",125=>"RBrace",91=>"LBracket",93=>"RBracket",58=>"Colon",44=>"Comma",59=>"Semicolon",43=>"Plus",42=>"Star",47=>"Slash",37=>"Percent",45=>"Minus",61=>"Eq",33=>"Bang",124=>"Pipe",60=>"Lt",62=>"Gt",63=>"Question",46=>"Dot",_=>""};if single==""{Err(fail("E001",i,i+1))}else{Ok(Tok(single,i+1))}}
lex(s:Bytes)->Result<[String],String>{var out:[String]=[];var i=0;let n=len(s);while i<n{let b=s[i];if is_space(b){i=i+1;continue;}if b==47&&at(s,i+1)==47{while i<n&&s[i]!=10{i=i+1;}continue;}let t=if is_word(b){word(s,i)}else if b==34{string(s,i)?}else if is_digit(b){number(s,i)?}else{symbol(s,i)?};out.push(t.kind+" "+String(i)+" "+String(t.end));i=t.end;}out.push("Eof "+String(n)+" "+String(n));Ok(out)}
main()->Unit{let source=match read_stdin(){Ok(text)=>text,Err(error)=>{print("error input");exit(2)}};match lex(utf8_encode(source)){Ok(tokens)=>{print(join(tokens,"\n"));},Err(error)=>{print("error "+error);exit(1);}}}
